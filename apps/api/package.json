{
  "name": "@stratafetch/api",
  "version": "1.0.0-alpha.2",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "test": "vitest run src",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "10.1.2",
    "@sentry/node": "10.72.0",
    "@stratafetch/contracts": "*",
    "ajv": "8.20.0",
    "bullmq": "5.80.2",
    "cheerio": "1.2.0",
    "fastify": "5.12.1",
    "ipaddr.js": "2.4.0",
    "pdf-parse": "2.4.5",
    "pg": "8.22.0",
    "playwright": "1.61.1",
    "turndown": "7.2.4",
    "undici": "7.29.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/pg": "8.20.0",
    "@types/turndown": "5.0.6",
    "tsx": "4.23.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
